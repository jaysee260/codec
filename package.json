{
  "name": "matrix-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "seed": "node seed/seed.ts",
    "seed:reset": "node scripts/hs.mjs reset && node seed/seed.ts",
    "hs:up": "node scripts/hs.mjs up",
    "hs:down": "node scripts/hs.mjs down",
    "hs:reset": "node scripts/hs.mjs reset",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:report": "playwright show-report",
    "test:e2e:fixtures": "node e2e/fixtures/make-test-assets.mjs",
    "test:e2e:fresh": "npm run seed:reset && npm run test:e2e",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "lucide-react": "^1.49.0",
    "matrix-js-sdk": "^43.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}

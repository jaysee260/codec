{
  "name": "matrix-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "seed": "node seed/seed.ts",
    "seed:reset": "node scripts/hs.mjs reset && node seed/seed.ts",
    "hs:up": "node scripts/hs.mjs up",
    "hs:down": "node scripts/hs.mjs down",
    "hs:reset": "node scripts/hs.mjs reset",
    "hs:lan": "node scripts/lan-proxy.mjs",
    "toolchain": "node scripts/toolchain.mjs",
    "cap:sync": "vite build && cap sync",
    "cap:copy:ios": "cap copy ios",
    "cap:build:android": "node scripts/cap-build-android.mjs",
    "cap:build:android:lan": "node scripts/cap-build-android.mjs --lan",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "voice:sample": "node scripts/send-voice-sample.mjs",
    "thread:sample": "node scripts/send-thread-sample.mjs",
    "verify:threads": "node scripts/verify-thread-shell.mjs",
    "verify:phone": "node scripts/verify-phone-shell.mjs",
    "verify:gif": "node scripts/verify-gif.mjs",
    "gif:sample": "node scripts/send-gif-sample.mjs",
    "gif:fixtures": "node scripts/make-gif-fixtures.mjs",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:android-build": "node e2e/android-build.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:threads": "playwright test e2e/threads.spec.ts e2e/mobile-threads.spec.ts",
    "test:e2e:gif": "playwright test e2e/gif.spec.ts e2e/mobile-gif.spec.ts",
    "test:e2e:report": "playwright show-report",
    "test:e2e:fixtures": "node e2e/fixtures/make-test-assets.mjs",
    "test:e2e:fresh": "npm run seed:reset && npm run test:e2e",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/status-bar": "^7.0.6",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.49.0",
    "matrix-js-sdk": "^43.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@playwright/test": "^1.49.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}

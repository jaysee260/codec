# Homeserver base URL baked into the web client at build time (default when unset: http://localhost:8008).
# Phones: use the PC's LAN address printed by `npm run hs:lan`, e.g. VITE_HS_URL=http://192.168.1.20:8009
# (`npm run cap:build:android:lan` sets it automatically). Users can still override it at runtime on the
# login screen (Advanced > Homeserver URL, stored in localStorage `matrix-poc.hsUrl`).
VITE_HS_URL=http://localhost:8008

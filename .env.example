# Homeserver base URL baked into the web client at build time (default when unset: http://localhost:8008).
# Phones: use the PC's LAN address printed by `npm run hs:lan`, e.g. VITE_HS_URL=http://192.168.1.20:8009
# (`npm run cap:build:android:lan` sets it automatically). Users can still override it at runtime on the
# login screen (Advanced > Homeserver URL, stored in localStorage `matrix-poc.hsUrl`).
VITE_HS_URL=http://localhost:8008

# GIF picker (Phase 4). Klipy app key: create a free account at https://partner.klipy.com/ > API Keys > create a
# platform; a key in "Testing" mode allows 100 requests/hour (Production = unlimited, requested from the same panel).
# Unset = the built-in mock provider (8 fixture GIFs under public/gif-fixtures, works offline).
# The key is baked into the web bundle and the APK at build time, so anyone with the APK can extract it: use a
# Testing key or a key you can revoke. Without a rebuild, a runtime key can be set in localStorage
# `matrix-poc.gifApiKey` (dev console / QA). Klipy forbids proxying or re-hosting its media: the client calls
# api.klipy.com and loads GIFs from static.klipy.com directly; nothing is uploaded to the homeserver.
VITE_GIF_API_KEY=
# Optional: API origin override for QA stubs (page.route). Default https://api.klipy.com
# VITE_GIF_API_BASE=https://api.klipy.com

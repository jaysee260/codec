# deps / build
node_modules/
dist/
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# playwright
playwright-report/
test-results/
blob-report/
playwright/.cache/

# synapse data: keep only the config + log config, never the DB, media or signing key
homeserver/data/*
!homeserver/data/.gitkeep

# misc
.DS_Store
Thumbs.db
*.log

# seed outputs (regenerated by npm run seed)
seed/seed-output.json
seed/assets/*.png
e2e/results/
e2e/tmp/
playwright-report/
src/features/**/__dev__/
e2e/demo-mobile/

# Phase 3: generated by npm run thread:sample
seed/thread-sample.json
seed/e2ee-keys.json

# native Synapse venv for the test homeserver pool (scripts/lib/hs-native.mjs)
homeserver/.venv

# Phase 7: the local call stack (LiveKit binary, per-stack config/logs/state; scripts/lib/rtc-stack.mjs)
homeserver/.rtc
